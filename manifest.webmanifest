{
  "name": "SCAD Online",
  "short_name": "SCAD",
  "description": "View, customize and export OpenSCAD models on your phone.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14171c",
